generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminAccount {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String
  // Shown in the site header for a signed-in admin: a name and a photo (initials when empty).
  displayName      String    @default("")
  photoUrl         String    @default("")
  sessionTokenHash String?
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SiteSettings {
  id           String   @id @default("main")
  brandName    String   @default("Alaman Ulak")
  heroTitleKy  String
  heroTitleRu  String
  heroTextKy   String
  heroTextRu   String
  aboutTitleKy String
  aboutTitleRu String
  aboutTextKy  String
  aboutTextRu  String
  calendarTitleKy String @default("Кийинки беттештер")
  calendarTitleRu String @default("Ближайшие матчи")
  calendarTextKy  String @default("Федерация жыл бою республикалык жана эл аралык улак тартыш мелдештерин уюштурат. Жазгы ачылыштан тартып Нооруз, Эгемендүүлүк күнү жана кышкы кубокторго чейин ар бир сезондун өз чабышы бар. Төмөндө алдагы мелдештер жана өткөн турнирлердин жыйынтыктары.")
  calendarTextRu  String @default("Федерация круглый год проводит республиканские и международные турниры по улак тартышу. От весеннего открытия и Нооруза до Дня независимости и зимних кубков у каждого сезона свои состязания. Ниже — предстоящие турниры и итоги прошедших.")
  teamTitleKy String @default("Ат үстүндөгү биримдик")
  teamTitleRu String @default("Единство в седле")
  newsTitleKy String @default("Акыркы жаңылыктар")
  newsTitleRu String @default("Последние события")
  rulesTitleKy String @default("Эреже жана тартип")
  rulesTitleRu String @default("Правила и порядок")
  horsesTitleKy String @default("Ат каталогу")
  horsesTitleRu String @default("Каталог лошадей")
  contactTitleKy String @default("Сурооңуз барбы?")
  contactTitleRu String @default("Есть вопрос?")
  contactPhone String
  contactEmail String
  addressKy    String
  addressRu    String
  socialUrl    String   @default("")
  // Footer social links: a WhatsApp number and the Instagram and Facebook pages (each shown only when set)
  whatsappNumber String @default("")
  instagramUrl   String @default("")
  facebookUrl    String @default("")
  heroImageUrl String
  // The full-width photo band on the homepage, between tournaments and players: a photo, a title and a short
  // line, plus an optional YouTube video that opens in the player. bandShown hides the whole band.
  bandShown    Boolean  @default(true)
  bandImageUrl String   @default("/images/band-sonkul.jpg")
  bandTitleKy  String   @default("Улак тартыш — ата-бабадан калган мурас")
  bandTitleRu  String   @default("Улак тартыш — наследие предков")
  bandTextKy   String   @default("Тоо этегиндеги талаада чабандестер кылымдар бою ушундай чабышкан. Федерация бул салтты сактап, жаңы муунга өткөрөт.")
  bandTextRu   String   @default("Так всадники состязались в горных долинах веками. Федерация хранит эту традицию и передаёт её новому поколению.")
  bandVideoUrl String   @default("")
  updatedAt    DateTime @updatedAt
}

model NewsArticle {
  id          String   @id @default(cuid())
  titleKy     String
  titleRu     String
  excerptKy   String
  excerptRu   String
  bodyKy      String
  bodyRu      String
  imageUrl    String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tournament {
  id              String   @id @default(cuid())
  titleKy         String
  titleRu         String
  locationKy      String
  locationRu      String
  startsAt        DateTime
  endsAt          DateTime
  // Three prize places: the prize on offer (shown before the tournament) and the team that won it (after).
  prize1Ky        String   @default("")
  prize1Ru        String   @default("")
  winner1Ky       String   @default("")
  winner1Ru       String   @default("")
  prize2Ky        String   @default("")
  prize2Ru        String   @default("")
  winner2Ky       String   @default("")
  winner2Ru       String   @default("")
  prize3Ky        String   @default("")
  prize3Ru        String   @default("")
  winner3Ky       String   @default("")
  winner3Ru       String   @default("")
  // An optional note on the result, e.g. the final's score.
  resultSummaryKy String   @default("")
  resultSummaryRu String   @default("")
  // The tournament's photo (its card and page; empty: one of the site's photos) and the detailed information on
  // its own page, written by the admin.
  imageUrl        String   @default("")
  descriptionKy   String   @default("")
  descriptionRu   String   @default("")
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  playerCards     PlayerCard[]
}

model Player {
  id         String   @id @default(cuid())
  name       String
  positionKy String
  positionRu String
  number     Int?
  bioKy      String
  bioRu      String
  imageUrl   String
  // The club the player rides for, as text (teams are no longer a separate list).
  clubKy     String   @default("")
  clubRu     String   @default("")
  // Front of the player card shows the city; the back shows birth year, achievements and bio.
  cityKy         String @default("")
  cityRu         String @default("")
  birthYear      Int?
  achievementsKy String @default("")
  achievementsRu String @default("")
  // The player's card, shown on the players page: at most one, yellow or red (a second yellow makes it red).
  card       PlayerCard?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RuleSection {
  id        String   @id @default(cuid())
  titleKy   String
  titleRu   String
  bodyKy    String
  bodyRu    String
  // Felt-panel symbol on the rules page: horn | tumar | horse | tunduk | rosette | band ("" picks one by position).
  symbol    String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model HorseCategory {
  id        String         @id @default(cuid())
  nameKy    String
  nameRu    String
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  listings  HorseListing[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model HorseListing {
  id            String        @id @default(cuid())
  nameKy        String
  nameRu        String
  ageKy         String
  ageRu         String
  descriptionKy String
  descriptionRu String
  locationKy    String
  locationRu    String
  price         Int?
  // The bazaar card shows the main photo. The horse's own page shows the YouTube video (uploaded to the federation's
  // channel) and every photo: the main one, then photoUrls.
  videoUrl      String        @default("")
  imageUrl      String        @default("")
  photoUrls     String[]      @default([])
  // Shown on the horse's page: buyers contact the seller directly, not the federation.
  // Telegram and Instagram are kept as usernames (without @).
  sellerName      String      @default("")
  sellerPhone     String      @default("")
  sellerWhatsapp  String      @default("")
  sellerTelegram  String      @default("")
  sellerInstagram String      @default("")
  categoryId    String
  category      HorseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  published     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// People shown on the "about" page. kind: "leader" sits in the түндүк (one expected),
// "board" fans out as the уук, "regional" only appears on the map. region is an ISO code
// from src/lib/kg-regions.ts; any member with a region also shows on the map.
model FederationMember {
  id        String   @id @default(cuid())
  name      String
  roleKy    String
  roleRu    String
  bioKy     String   @default("")
  bioRu     String   @default("")
  photoUrl  String   @default("")
  kind      String   @default("board")
  region    String   @default("")
  phone     String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutPhoto {
  id        String   @id @default(cuid())
  imageUrl  String
  captionKy String
  captionRu String
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoryMilestone {
  id        String   @id @default(cuid())
  year      Int
  titleKy   String
  titleRu   String
  textKy    String   @default("")
  textRu    String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The Медиа page ("тушкийиз"): photos and optional videos with a category used by the thread filters.
// category: tournaments | players | horses | federation
model MediaItem {
  id        String   @id @default(cuid())
  imageUrl  String
  videoUrl  String   @default("")
  captionKy String
  captionRu String
  category  String   @default("federation")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A player's yellow or red card: when, optionally at which tournament, and why. One per player: a second yellow
// turns it red, and a red replaces a yellow.
model PlayerCard {
  id           String      @id @default(cuid())
  playerId     String      @unique
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  color        String      // "yellow" | "red"
  date         DateTime
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  reasonKy     String      @default("")
  reasonRu     String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// A photo the admin uploaded, kept in the database (the host's disk is wiped on every deploy) and served at
// /api/images/<id>. The admin's browser shrinks large photos before uploading.
model UploadedImage {
  id          String   @id @default(cuid())
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}
